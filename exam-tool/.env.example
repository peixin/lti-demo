# ==============================================================================
# LTI 1.3 Exam Tool Environment Configuration Template / 考试端环境变量模板
# ==============================================================================

# Port to bind Flask application in container and map to host
PORT=8002

# Flask Secret Key (Change in production!)
SECRET_KEY=exam-tool-demo-secret-change-in-prod

# SQLite database path inside the container (Do not change)
DATABASE=/app/data/exam-tool.db

# Administrator panel login password
ADMIN_PASSWORD=admin
