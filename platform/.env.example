# ==============================================================================
# LTI 1.3 Platform Environment Configuration Template / 平台端环境变量模板
# ==============================================================================

# Port to bind Flask application in container and map to host
PORT=8001

# Flask Secret Key (Change in production!)
SECRET_KEY=platform-demo-secret-change-in-prod

# SQLite database path inside the container (Do not change)
DATABASE=/app/data/platform.db
